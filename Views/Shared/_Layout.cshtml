<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; BudgetTracker</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <a class="header-brand" asp-controller="Budget" asp-action="Index">
            <span class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2v20M12 8l6-4M12 14l-6-4" />
                </svg>
            </span>
            BudgetTracker
        </a>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="header-toggle" type="button" data-sidebar-toggle aria-label="Toggle navigation">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
            </button>

            <div class="header-right">
                <div class="header-user">
                    <span class="avatar">@User.Identity.Name?.Substring(0, 1)</span>
                    <span>@User.Identity.Name</span>
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm" type="submit">Sign out</button>
                </form>
            </div>
        }
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <aside class="sidebar">
            @await RenderSectionAsync("Sidebar", required: false)
        </aside>

        <div class="sidebar-backdrop" data-sidebar-toggle></div>
    }

    <main class="main">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
