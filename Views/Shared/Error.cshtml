@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="pagetitle">
    <h1>Something went wrong</h1>
</div>

<div class="card">
    <div class="card-body prose">
        <p>The request could not be completed. Try again, and if it keeps happening check the application log.</p>

        @if (Model.ShowRequestId)
        {
            <p class="muted">Reference: <code>@Model.RequestId</code></p>
        }

        <p><a asp-controller="Budget" asp-action="Index">Back to the dashboard</a></p>
    </div>
</div>
