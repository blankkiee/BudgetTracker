@model BudgetTracker.ViewModels.RegisterRequest

@{
    ViewData["Title"] = "Create account";
    Layout = "_AuthLayout";
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="notice notice-warn" asp-validation-summary="All"></div>
}

<div class="card">
    <div class="card-body">
        <h1 class="auth-title">Create account</h1>
        <p class="auth-sub">Your budgets stay private to your account.</p>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="field">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" autocomplete="username" autofocus />
                <div class="auth-hint">A name or an email address.</div>
            </div>

            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
                <div class="auth-hint">At least 8 characters.</div>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            </div>

            <button class="btn btn-primary btn-block" type="submit" style="margin-top: 1.1rem;">Create account</button>
        </form>
    </div>
</div>

<p class="auth-alt">
    Already have an account? <a asp-controller="Account" asp-action="Login">Sign in</a>
</p>
