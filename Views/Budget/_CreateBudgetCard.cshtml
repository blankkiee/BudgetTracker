@model BudgetTracker.ViewModels.BudgetDashboardViewModel
@using System.Globalization

<div class="card panel">
    <div class="card-body">
        <div class="card-title">New budget</div>

        <form asp-action="CreateBudget" method="post">
            @Html.AntiForgeryToken()

            <div class="cluster">
                <div class="field" style="flex: 2 1 12rem;">
                    <label for="new-budget-name">Name</label>
                    <input id="new-budget-name" type="text" name="name" placeholder="1st Cut-Off" />
                </div>

                <div class="field" style="flex: 0 1 9rem;">
                    <label for="new-budget-month">Month</label>
                    <select id="new-budget-month" name="month">
                        @for (var i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == Model.Month)">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                        }
                    </select>
                </div>

                <div class="field" style="flex: 0 1 6rem;">
                    <label for="new-budget-year">Year</label>
                    <input id="new-budget-year" type="number" name="year" value="@Model.Year" min="2000" max="2100" />
                </div>

                <div class="field" style="flex: 0 1 9rem;">
                    <label for="new-budget-amount">Amount</label>
                    <input id="new-budget-amount" type="number" step="0.01" min="0" name="totalBudget" placeholder="0.00" />
                </div>
            </div>

            @if (Model.HasPreviousMonthBudget)
            {
                <label class="check" style="margin-top: 0.85rem;">
                    <input type="checkbox" value="true" name="copyCategoriesFromPreviousMonth" />
                    Copy categories from the previous month
                </label>
            }

            <div class="actions">
                <button class="btn btn-primary" type="submit">Create budget</button>
                <button class="btn" type="button" data-panel-target="panel-new-budget">Cancel</button>
            </div>
        </form>
    </div>
</div>
