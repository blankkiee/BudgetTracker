@model BudgetTracker.ViewModels.BudgetDashboardViewModel

<div class="card panel">
    <div class="card-body">
        <div class="card-title">Edit budget</div>

        @if (Model.BudgetMonthId is null)
        {
            <p class="muted" style="font-size: 0.85rem; margin: 0;">Create a budget for this month first.</p>
        }
        else
        {
            <form asp-action="SetMonthlyBudget" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="budgetMonthId" value="@Model.BudgetMonthId" />

                <div class="cluster">
                    <div class="field" style="flex: 2 1 12rem;">
                        <label for="edit-budget-name">Name</label>
                        <input id="edit-budget-name" type="text" name="name" value="@Model.BudgetName" />
                    </div>

                    <div class="field" style="flex: 0 1 9rem;">
                        <label for="edit-budget-amount">Total budget</label>
                        <input id="edit-budget-amount" type="number" step="0.01" min="0" name="totalBudget" value="@Model.TotalBudget" />
                    </div>
                </div>

                <div class="actions">
                    <button class="btn btn-primary" type="submit">Save changes</button>
                    <button class="btn" type="button" data-panel-target="panel-edit-budget">Cancel</button>
                </div>
            </form>

            <div style="margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--line);">
                <form asp-action="DeleteMonthlyBudget" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="budgetMonthId" value="@Model.BudgetMonthId" />
                    <button class="link-danger" type="submit" onclick="return confirm('Delete this budget with all its categories and expenses? This cannot be undone.');">Delete this budget</button>
                </form>
            </div>
        }
    </div>
</div>
