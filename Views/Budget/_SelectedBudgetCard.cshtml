@model BudgetTracker.ViewModels.BudgetDashboardViewModel

<div class="card form-card h-100">
    <div class="card-body p-3 p-md-4">
        <h2 class="h5 mb-2">Selected budget</h2>
        <p class="text-muted mb-3">Update the active budget version for this month.</p>

        @if (Model.BudgetMonthId is null)
        {
            <div class="alert alert-info">Open or create a budget version first.</div>
        }
        else
        {
            <div class="mb-2">
                <div class="text-muted small">Active budget</div>
                <div class="fw-semibold">@Model.BudgetName</div>
            </div>

            <form asp-action="SetMonthlyBudget" method="post" class="dashboard-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="budgetMonthId" value="@Model.BudgetMonthId" />

                <div class="mb-2">
                    <label class="form-label">Budget name</label>
                    <input class="form-control" type="text" name="name" value="@Model.BudgetName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Total budget</label>
                    <input class="form-control form-control-lg" type="number" step="0.01" name="totalBudget" value="@Model.TotalBudget" />
                </div>

                <div class="row g-2">
                    <div class="col-6 d-grid">
                        <button class="btn btn-primary" type="submit">Save budget</button>
                    </div>

                    <div class="col-6 d-grid">
                        <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteBudgetModal-@Model.BudgetMonthId">Delete budget</button>
                    </div>
                </div>
            </form>

            <div class="modal fade" id="deleteBudgetModal-@Model.BudgetMonthId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Delete budget</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Delete this budget version and its categories and expenses?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <form asp-action="DeleteMonthlyBudget" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="budgetMonthId" value="@Model.BudgetMonthId" />
                                <button class="btn btn-danger" type="submit">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>