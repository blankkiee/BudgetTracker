@model BudgetTracker.ViewModels.BudgetDashboardViewModel

<div class="card form-card h-100">
    <div class="card-body p-3 p-md-4">
        <h2 class="h5 mb-2">Add category</h2>
        <p class="text-muted mb-3">Examples: Groceries, Utilities, Transport.</p>

        @if (Model.BudgetMonthId is null)
        {
            <div class="alert alert-info mb-0">Save the monthly budget first, then add categories.</div>
        }
        else
        {
            <form asp-action="AddCategory" method="post" class="dashboard-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="budgetMonthId" value="@Model.BudgetMonthId" />

                <div class="mb-2">
                    <label class="form-label">Category name</label>
                    <input class="form-control" type="text" name="name" placeholder="Groceries" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Category budget</label>
                    <input class="form-control" type="number" step="0.01" name="budgetAmount" placeholder="250.00" />
                </div>

                <button class="btn btn-outline-primary" type="submit">Add category</button>
            </form>
        }
    </div>
</div>