@model BudgetTracker.ViewModels.BudgetDashboardViewModel

<div class="card panel">
    <div class="card-body">
        <div class="card-title">New category</div>

        @if (Model.BudgetMonthId is null)
        {
            <p class="muted" style="font-size: 0.85rem; margin: 0;">Create a budget for this month first.</p>
        }
        else
        {
            <form asp-action="AddCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="budgetMonthId" value="@Model.BudgetMonthId" />

                <div class="cluster">
                    <div class="field" style="flex: 2 1 12rem;">
                        <label for="new-category-name">Name</label>
                        <input id="new-category-name" type="text" name="name" placeholder="Groceries" />
                    </div>

                    <div class="field" style="flex: 0 1 9rem;">
                        <label for="new-category-amount">Amount</label>
                        <input id="new-category-amount" type="number" step="0.01" min="0" name="budgetAmount" placeholder="0.00" />
                    </div>
                </div>

                <div class="actions">
                    <button class="btn btn-primary" type="submit">Add category</button>
                    <button class="btn" type="button" data-panel-target="panel-add-category">Cancel</button>
                </div>
            </form>
        }
    </div>
</div>
