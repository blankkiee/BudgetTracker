@model BudgetTracker.ViewModels.BudgetDashboardViewModel
@using System.Globalization

@{
    var currentMonthDate = new DateTime(Model.Year, Model.Month, 1);
    var previousMonth = currentMonthDate.AddMonths(-1);
    var nextMonth = currentMonthDate.AddMonths(1);
}

<div class="card form-card h-100">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center mb-2">
            <div>
                <h2 class="h5 mb-1">Open a month</h2>
                <p class="text-muted mb-0">Choose a month and year to view or edit that budget.</p>
            </div>

            <div class="btn-group flex-wrap">
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@previousMonth.Year" asp-route-month="@previousMonth.Month">Previous month</a>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@DateTime.Today.Year" asp-route-month="@DateTime.Today.Month">Current month</a>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@nextMonth.Year" asp-route-month="@nextMonth.Month">Next month</a>
            </div>
        </div>

        <form asp-action="Index" method="get" class="dashboard-form">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Year</label>
                    <input class="form-control" type="number" name="year" min="2024" max="2100" value="@Model.Year" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Month</label>
                    <select class="form-select" name="month">
                        @for (var i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(i == Model.Month)">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Budget status</label>
                    <input class="form-control" type="text" value="@(Model.BudgetMonthId is null ? "No budget created yet" : "Budget exists")" readonly />
                </div>

                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary" type="submit">Open month</button>
                </div>
            </div>
        </form>

        <div class="mt-3">
            <div class="text-muted small mb-2">Budgets in this month</div>

            @if (Model.AvailableBudgets.Any())
            {
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var budget in Model.AvailableBudgets)
                    {
                        <a class="btn @(budget.IsSelected ? "btn-dark" : "btn-outline-dark")" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-budgetMonthId="@budget.Id">
                            @budget.Name
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-muted">No budgets created for this month yet.</div>
            }
        </div>
    </div>
</div>