@model BudgetTracker.ViewModels.CategoryBudgetViewModel

<div class="card category-card h-100">
    <div class="card-header category-card-header d-flex justify-content-between align-items-center gap-3">
        <button class="category-collapse-trigger btn btn-link text-start p-0 flex-grow-1 text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#category-@Model.Id" aria-expanded="false" aria-controls="category-@Model.Id">
            <div class="category-title">@Model.Name</div>
            <div class="category-subtitle">Budget: @Model.BudgetAmount.ToString("C")</div>
        </button>

        <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-light text-dark category-badge">Collapsed by default</span>

            <form asp-action="DeleteCategory" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoryBudgetId" value="@Model.Id" />
                <button class="btn btn-sm btn-outline-light" type="submit" onclick="return confirm('Delete this category and all of its expenses?');">Delete</button>
            </form>
        </div>
    </div>

    <div id="category-@Model.Id" class="collapse">
        <div class="card-body p-3 p-md-4 border-top border-2">
            <div class="row g-2 mb-3">
                <div class="col-12 col-md-4">
                    <div class="stat-chip">
                        <span class="stat-label">Spent</span>
                        <span class="stat-value">@Model.Spent.ToString("C")</span>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="stat-chip">
                        <span class="stat-label">Left</span>
                        <span class="stat-value">@Model.Remaining.ToString("C")</span>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="stat-chip">
                        <span class="stat-label">Expenses</span>
                        <span class="stat-value">@Model.Expenses.Count</span>
                    </div>
                </div>
            </div>

            <form asp-action="SaveCategory" method="post" class="dashboard-form category-edit-form mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoryBudgetId" value="@Model.Id" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Category name</label>
                        <input class="form-control" type="text" name="name" value="@Model.Name" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Budget amount</label>
                        <input class="form-control" type="number" step="0.01" name="budgetAmount" value="@Model.BudgetAmount" />
                    </div>

                    <div class="col-md-2 d-grid">
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </div>
            </form>

            <div class="expenses-section">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3 class="h6 mb-0">Expenses</h3>
                    <span class="text-muted small">Edit or remove each item</span>
                </div>

                @if (!Model.Expenses.Any())
                {
                    <div class="text-muted mb-2">No expenses yet.</div>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle expense-table mb-0">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                    <th>Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var expense in Model.Expenses)
                                {
                                    var expenseFormId = $"expense-form-{expense.Id}";

                                    <tr>
                                        <td>
                                            <input type="hidden" form="@expenseFormId" name="expenseId" value="@expense.Id" />
                                            <input type="hidden" form="@expenseFormId" name="categoryBudgetId" value="@Model.Id" />
                                            <form id="@expenseFormId" asp-action="SaveExpense" method="post" class="dashboard-form expense-inline-form"></form>
                                            <input class="form-control form-control-sm" type="text" name="description" value="@expense.Description" form="@expenseFormId" />
                                        </td>
                                        <td class="text-end" style="width: 120px;">
                                            <input class="form-control form-control-sm text-end" type="number" step="0.01" name="amount" value="@expense.Amount" form="@expenseFormId" />
                                        </td>
                                        <td style="width: 140px;">
                                            <input class="form-control form-control-sm" type="date" name="purchasedAt" value="@expense.PurchasedAt.ToString("yyyy-MM-dd")" form="@expenseFormId" />
                                        </td>
                                        <td class="text-end" style="width: 150px;">
                                            <div class="d-flex justify-content-end gap-2">
                                                <button class="btn btn-sm btn-outline-primary" type="submit" form="@expenseFormId">Save</button>
                                            </div>
                                            <form asp-action="DeleteExpense" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="expenseId" value="@expense.Id" />
                                                <button class="btn btn-sm btn-link text-danger px-0" type="submit" onclick="return confirm('Delete this expense?');">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="add-expense-card p-3 rounded-4">
                    <h4 class="h6 mb-2">Add new expense</h4>

                    <form asp-action="AddExpense" method="post" class="dashboard-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="categoryBudgetId" value="@Model.Id" />

                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-md-5">
                                <label class="form-label">Description</label>
                                <input class="form-control" type="text" name="description" placeholder="Milk" />
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label">Amount</label>
                                <input class="form-control" type="number" step="0.01" name="amount" placeholder="3.50" />
                            </div>

                            <div class="col-6 col-md-2">
                                <label class="form-label">Date</label>
                                <input class="form-control" type="date" name="purchasedAt" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>

                            <div class="col-md-2 d-grid">
                                <button class="btn btn-dark" type="submit">Add</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>