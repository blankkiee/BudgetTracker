@model BudgetTracker.ViewModels.CategoryBudgetViewModel

@{
    var state = Model.IsOverspent ? "over" : Model.IsNearLimit ? "near" : "ok";
    var remainingText = Model.IsOverspent
        ? "over by " + (Model.Spent - Model.BudgetAmount).ToString("C")
        : Model.Remaining.ToString("C") + " left";
}

<details class="row">
    <summary class="row-head">
        <span class="row-name">
            <span class="dot is-@state" aria-hidden="true"></span>
            <span>@Model.Name</span>
        </span>

        <span class="cell cell-strong r @(Model.IsOverspent ? "is-over" : "")">@Model.Spent.ToString("C")</span>

        <span class="cell r col-budget">@Model.BudgetAmount.ToString("C")</span>

        <span class="col-progress">
            <span class="bar bar-thin">
                <span class="bar-fill @(state == "over" ? "is-over" : state == "near" ? "is-near" : "")" style="width: @Model.BarPercent%"></span>
            </span>
        </span>

        <span class="row-pct">@Model.PercentUsed%</span>

        <span class="caret" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </span>
    </summary>

    <div class="row-body">
        <form asp-action="SaveCategory" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="categoryBudgetId" value="@Model.Id" />

            <div class="cluster">
                <div class="field" style="flex: 2 1 11rem;">
                    <label for="category-name-@Model.Id">Category name</label>
                    <input id="category-name-@Model.Id" type="text" name="name" value="@Model.Name" />
                </div>

                <div class="field" style="flex: 0 1 9rem;">
                    <label for="category-amount-@Model.Id">Budget amount</label>
                    <input id="category-amount-@Model.Id" type="number" step="0.01" min="0" name="budgetAmount" value="@Model.BudgetAmount" />
                </div>

                <button class="btn btn-sm" type="submit">Save</button>
            </div>
        </form>

        <div class="card-title" style="padding: 1.25rem 0 0.5rem;">
            Expenses
            <span>@Model.Expenses.Count item(s) &middot; @remainingText</span>
        </div>

        @if (Model.Expenses.Any())
        {
            <div class="table-scroll">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="r">Amount</th>
                            <th>Date</th>
                            <th class="r"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.Expenses)
                        {
                            var formId = "expense-form-" + expense.Id;

                            <tr>
                                <td>
                                    <form id="@formId" asp-action="SaveExpense" method="post"></form>
                                    <input type="hidden" form="@formId" name="expenseId" value="@expense.Id" />
                                    <input type="hidden" form="@formId" name="categoryBudgetId" value="@Model.Id" />
                                    <input type="text" name="description" value="@expense.Description" form="@formId" aria-label="Description" />
                                </td>
                                <td class="r" style="width: 7.5rem;">
                                    <input type="number" step="0.01" min="0" name="amount" value="@expense.Amount" form="@formId" aria-label="Amount" />
                                </td>
                                <td style="width: 10rem;">
                                    <input type="date" name="purchasedAt" value="@expense.PurchasedAt.ToString("yyyy-MM-dd")" form="@formId" aria-label="Date" />
                                </td>
                                <td class="r" style="width: 8rem; white-space: nowrap;">
                                    <button class="btn btn-sm" type="submit" form="@formId">Save</button>

                                    <form asp-action="DeleteExpense" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="expenseId" value="@expense.Id" />
                                        <button class="link-danger" type="submit" onclick="return confirm('Delete this expense?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="muted" style="font-size: 0.85rem; margin: 0;">No expenses logged yet.</p>
        }

        <form asp-action="AddExpense" method="post" style="margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--line);">
            @Html.AntiForgeryToken()
            <input type="hidden" name="categoryBudgetId" value="@Model.Id" />

            <div class="cluster">
                <div class="field" style="flex: 2 1 11rem;">
                    <label for="expense-desc-@Model.Id">Add an expense</label>
                    <input id="expense-desc-@Model.Id" type="text" name="description" placeholder="Description" />
                </div>

                <div class="field" style="flex: 0 1 7.5rem;">
                    <label for="expense-amount-@Model.Id">Amount</label>
                    <input id="expense-amount-@Model.Id" type="number" step="0.01" min="0" name="amount" placeholder="0.00" />
                </div>

                <div class="field" style="flex: 0 1 10rem;">
                    <label for="expense-date-@Model.Id">Date</label>
                    <input id="expense-date-@Model.Id" type="date" name="purchasedAt" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <button class="btn btn-sm btn-primary" type="submit">Add</button>
            </div>
        </form>

        <div style="margin-top: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--line);">
            <form asp-action="DeleteCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="categoryBudgetId" value="@Model.Id" />
                <button class="link-danger" type="submit" onclick="return confirm('Delete this category and all of its expenses?');">Delete this category</button>
            </form>
        </div>
    </div>
</details>
